{
  "description": "Environment variables every SDK reads, with units and defaults.",
  "prefix": "AXONPUSH_",
  "variables": {
    "AXONPUSH_API_KEY": {
      "type": "string",
      "default": null
    },
    "AXONPUSH_TENANT_ID": {
      "type": "string",
      "default": null,
      "aliases": [
        "AXONPUSH_ORG_ID"
      ]
    },
    "AXONPUSH_APP_ID": {
      "type": "string",
      "default": null
    },
    "AXONPUSH_CHANNEL_ID": {
      "type": "string",
      "default": null
    },
    "AXONPUSH_BASE_URL": {
      "type": "string",
      "default": "https://api.axonpush.xyz"
    },
    "AXONPUSH_ENVIRONMENT": {
      "type": "string",
      "default": null
    },
    "AXONPUSH_TIMEOUT": {
      "type": "number",
      "unit": "seconds",
      "default": 30
    },
    "AXONPUSH_MAX_RETRIES": {
      "type": "integer",
      "default": 3
    },
    "AXONPUSH_FAIL_OPEN": {
      "type": "boolean",
      "default": true
    },
    "AXONPUSH_CONTENT_CAPTURE": {
      "type": "enum",
      "values": [
        "metadata_only",
        "redacted",
        "full"
      ],
      "default": "metadata_only"
    },
    "AXONPUSH_REDACT_KEYS": {
      "type": "string[]",
      "separator": ",",
      "default": []
    },
    "AXONPUSH_MAX_CONTENT_LENGTH": {
      "type": "integer",
      "unit": "characters",
      "default": 4096
    }
  },
  "retry": {
    "backoffMs": [
      250,
      500,
      1000,
      2000,
      4000
    ],
    "policy": "fixed ladder, clamped to the last entry",
    "honoursRetryAfter": true,
    "retryOn": [
      408,
      429,
      500,
      502,
      503,
      504,
      "connection-error"
    ]
  }
}
