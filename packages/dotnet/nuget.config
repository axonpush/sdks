<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin the feed list. A machine-level local source that does not exist fails
    restore with NU1301 before any package is looked up.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
