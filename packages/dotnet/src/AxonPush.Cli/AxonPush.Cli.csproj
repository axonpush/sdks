<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AxonPush.Cli</RootNamespace>
    <AssemblyName>axonpush-eval</AssemblyName>
    <Description>Replays a dataset revision against a local evaluator and applies the release gate.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>axonpush-eval</ToolCommandName>
    <PackageId>AxonPush.Cli</PackageId>
    <PackageTags>axonpush;ci;evaluation;release-gate;llm;agents</PackageTags>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AxonPush\AxonPush.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AxonPush.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
